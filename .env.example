# 구글 OAuth 클라이언트 ID
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보에서 발급
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 서버사이드 전용 (Vercel 환경변수에 설정, .env에는 넣지 말 것)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com

# 학원 회신 링크 (docs/학원-회신.md)
# 서버사이드 전용 — Vercel 환경변수에 설정
# SNS_REPLY_SECRET      : 회신 주소의 서명 키. 없으면 링크를 만들지도 열지도 않는다
# APPS_SCRIPT_REPLY_KEY : Apps Script 의 Script Property REPLY_API_KEY 와 같은 값
# PUBLIC_BASE_URL       : 로컬에서만. 앱(5173)과 함수(3000)의 포트가 달라 링크에 앱 쪽을 일러 준다
#                         (배포에서는 비워 둔다 — 요청 헤더의 host 를 쓴다)
